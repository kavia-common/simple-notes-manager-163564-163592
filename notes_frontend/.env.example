# PUBLIC INTERFACE
# Environment variables needed by the Remix frontend.
# The orchestrator will populate these in .env for the deployment environment.

# Base URL of the notes_db backend API (e.g., http://localhost:8000 or https://api.example.com)
NOTES_API_BASE_URL=http://localhost:8000

# Session secret for securing cookies (change this in production)
SESSION_SECRET=please-change-me

# Optional: Used for building absolute redirect URIs in emails if your backend needs them
SITE_URL=http://localhost:3000
